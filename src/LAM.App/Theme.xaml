<!--
    The "Industry" design system.

    A light technical ground, one steel accent, square corners, hairline borders, and registration
    marks on framed objects. Three rules carry the whole look, and breaking any one of them is
    immediately visible:

      * Radius is 0. Everywhere, on everything, no exceptions.
      * Borders are 1px. Frames use the divider brush; the window shell is slightly stronger.
      * There is one hue. Warnings use ink plus a hazard hatch — never red.

    Every control is fully re-templated rather than merely recoloured. WPF's default templates draw
    their own chrome and only inherit the foreground, so a style that sets colours without replacing
    the template yields dark text on a stock white popup. ThemeTests fails the build if that happens.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:svc="clr-namespace:LAM.App.Services"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Colours are NOT defined here.

        They live in Themes/Light.xaml and Themes/Dark.xaml, merged by App.xaml, and are looked up
        with DynamicResource throughout this file so swapping the palette at runtime takes effect
        immediately. A StaticResource here would bind once at load and the app would keep the
        palette it started with.
    -->

    <!-- ==================== PATTERNS ====================

         The design DELETED the diagonal hatch — "it reads cheap". Raised panels are a solid surface
         step (RaisedSurface) instead, and the rank plate, icon frame, panel header bands and the
         vault-lock ground all use it.

         One pattern survives, and only in one place: the 9px edge bar of a warning plate. Text never
         sits on it — that was the earlier draft's mistake and it was illegible. -->

    

    <!-- Hazard: account warnings. Wider 5px band. Ink, never red. -->
    <DrawingBrush x:Key="HazardHatch" TileMode="Tile" Viewport="0,0,10,10"
                  ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Thickness="5">
                        <Pen.Brush>
                            <SolidColorBrush Color="{DynamicResource InkColor}" Opacity="0.10" />
                        </Pen.Brush>
                    </Pen>
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="-2,12" EndPoint="12,-2" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    

    <!-- ==================== TYPE ==================== -->

    <FontFamily x:Key="HeadingFont">pack://application:,,,/Assets/Fonts/#Barlow Condensed</FontFamily>
    <FontFamily x:Key="BodyFont">pack://application:,,,/Assets/Fonts/#Barlow</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Menlo, Courier New</FontFamily>

    <!-- Condensed headings: uppercase, wide tracking. WPF has no letter-spacing, so tracking is
         applied per-use with a TextBlock attached property where it matters most. -->
    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource Heading}">
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!--
        All metadata.

        11px is the floor and 68% ink the minimum — both measured, and both failures of the earlier
        draft: 10px mono at 55% came out under 4:1. Nothing in the app may go below either.
    -->
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>

    <!-- ==================== REGISTRATION MARKS ====================
         Four crosshairs, one per corner, drawn *outside* the frame by 6px.

         Note the hazard the design calls out: they sit outside the element's bounds, so any ancestor
         that clips will swallow them. Anything wrapped in this needs 6px of breathing room and no
         ClipToBounds on the way up. -->
    <Style x:Key="RegistrationMark" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource RegMark}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Data" Value="M 5.5,0 L 5.5,11 M 0,5.5 L 11,5.5" />
    </Style>

    <!-- A framed object: 1px border on the ground, with its four marks. Use as the outer container
         of any panel, plate or dialog. -->
    <ControlTemplate x:Key="FramedTemplate" TargetType="ContentControl">
        <Grid Margin="6">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter />
            </Border>
            <Path Style="{StaticResource RegistrationMark}" HorizontalAlignment="Left"
                  VerticalAlignment="Top" Margin="-6,-6,0,0" />
            <Path Style="{StaticResource RegistrationMark}" HorizontalAlignment="Right"
                  VerticalAlignment="Top" Margin="0,-6,-6,0" />
            <Path Style="{StaticResource RegistrationMark}" HorizontalAlignment="Left"
                  VerticalAlignment="Bottom" Margin="-6,0,0,-6" />
            <Path Style="{StaticResource RegistrationMark}" HorizontalAlignment="Right"
                  VerticalAlignment="Bottom" Margin="0,0,-6,-6" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="Framed" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource Ground}" />
        <Setter Property="Padding" Value="13" />
        <Setter Property="Template" Value="{StaticResource FramedTemplate}" />
    </Style>

    <!--
        The focus ring.

        Applied implicitly to every control below rather than offered as a keyed style: it was a keyed
        style with no call sites, so what actually drew was Windows' dotted marquee — the one thing the
        design forbids by name.
    -->
    <Style x:Key="AccentFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{DynamicResource AccentSolid}" StrokeThickness="2"
                               Margin="-2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Elevation.

        The design gives the window shell, dialogs and the toast a deep soft shadow, and the primary
        button and hovered card a coloured glow. Nothing in the app had either, which is most of why
        surfaces read as painted regions rather than as stacked plates.

        A glow must remain a VALID effect in both themes rather than being dropped in light: an absent
        effect and a transparent one animate differently, and the light palette therefore defines
        GlowColor as fully transparent instead of omitting it.
    -->
    <DropShadowEffect x:Key="Elevated" BlurRadius="60" ShadowDepth="24" Direction="270"
                      Color="{DynamicResource ShadowColor}" Opacity="0.5" />

    <DropShadowEffect x:Key="Glow" BlurRadius="18" ShadowDepth="0"
                      Color="{DynamicResource GlowColor}" Opacity="0.35" />

    <!--
        Frameless window chrome, as one template the secondary windows adopt.

        They all used stock Windows chrome, which put a rounded system-coloured title bar on top of a
        radius-0 frameless app and ignored the theme entirely — a dark session raised light dialogs.
        Adopting it is one attribute plus a Title; the caption buttons run on SystemCommands because a
        template in a resource dictionary has no code-behind to hold click handlers.
    -->
    <!-- ==================== BUTTONS ==================== -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource AccentSolid}" />
        <Setter Property="Foreground" Value="{DynamicResource Reversed}" />
        <Setter Property="Effect" Value="{DynamicResource Glow}" />
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- The marks live in the template, so every primary button carries them without
                         each call site remembering. Margin 6 gives them the room they need to sit
                         outside the fill; a clipping ancestor would still swallow them. -->
                    <Grid>
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SecondaryHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger reads as ink, not red: the system has one hue and warnings earn their weight from
         the hazard hatch and explicit wording instead. -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Ink}" />
        <Setter Property="Foreground" Value="{DynamicResource Reversed}" />
    </Style>

    <!-- Title-bar minimise / maximise / close. 38x30, no border, distinct close hover. -->
    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ChromeHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CloseHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChromeLabelBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="svc:Tracking.Em" Value="0.16" />
    </Style>

    <Style x:Key="ShellWindow" TargetType="Window">
        <Setter Property="svc:Frameless.Enabled" Value="True" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{DynamicResource Ground}" BorderThickness="1"
                            BorderBrush="{DynamicResource ShellBorder}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="38"
                                    Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <Image Source="pack://application:,,,/Assets/hextech-small.png"
                                               Width="16" Height="16"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{TemplateBinding Title}"
                                                   Style="{StaticResource ChromeLabelBase}"
                                                   Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ChromeButton}" Content="&#x2715;"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                                ToolTip="Close" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <AdornerDecorator>
                                <ContentPresenter />
                            </AdornerDecorator>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==================== INPUTS ==================== -->

    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="14" Height="14" BorderBrush="{DynamicResource CheckBorder}"
                                BorderThickness="1" Background="Transparent" VerticalAlignment="Center">
                            <Border x:Name="Fill" Margin="2" Background="{DynamicResource Accent}"
                                    Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The default RadioButton.

        The shell's nav tabs and segmented controls carry their own keyed templates, but an
        un-styled RadioButton anywhere else would fall back to WPF's bevelled circle — round, in a
        system whose first rule is that nothing is round. So the default is templated too: a square
        mark, matching the CheckBox.
    -->
    <Style TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border Width="14" Height="14" BorderBrush="{DynamicResource CheckBorder}"
                                BorderThickness="1" Background="Transparent" VerticalAlignment="Center">
                            <Border x:Name="Fill" Margin="3" Background="{DynamicResource Accent}"
                                    Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 38x20 track, 14px knob inset 2. On uses an accent-tinted track so the knob stays legible. -->
    <Style x:Key="SettingToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="38" Height="20" Background="Transparent"
                            BorderBrush="{DynamicResource DashedBorder}" BorderThickness="1">
                        <Border x:Name="Knob" Width="14" Height="14" Margin="2"
                                HorizontalAlignment="Left" Background="{DynamicResource ToggleKnobOff}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleOnTrack}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The bare text box an editable ComboBox hosts.

        It needs its own stripped template: the ordinary TextBox style draws a border and a fill, and
        nesting that inside the combo's own frame produces a box inside a box.
    -->
    <Style x:Key="ComboBoxEditableTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Tooltips are templated for the same reason as everything else: WPF's default draws its own
        pale chrome with an OS border and a drop shadow, which reads as a different application
        entirely sitting on top of this one.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Ground}"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                            Padding="9,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PART_Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{DynamicResource Surface}"
                                            BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="22" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" Data="M 0,0 L 8,0 L 4,5 Z"
                                                  Fill="{DynamicResource MutedText}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="Selection" Margin="9,0,24,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          IsHitTestVisible="False" />

                        <!-- Editable combos need a real TextBox named PART_EditableTextBox, or they
                             cannot be typed into. Hidden unless IsEditable. -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Style="{StaticResource ComboBoxEditableTextBox}"
                                 Margin="9,0,24,0" VerticalAlignment="Center"
                                 Visibility="Collapsed"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />

                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="None">
                            <Border Background="{DynamicResource Ground}"
                                    BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer MaxHeight="260">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Selection" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SegmentSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== LISTS ==================== -->

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SegmentSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== SCROLLBARS ==================== -->

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource InactiveFill}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPageButton}"
                                          Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPageButton}"
                                          Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="9" />
                <Setter Property="Width" Value="Auto" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Background" Value="{DynamicResource InactiveFill}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left" />
                        <Border x:Name="PART_Track" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== TABS ==================== -->

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Margin="0" />
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome" Background="Transparent" Padding="16,0"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2" Height="46">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Text colour deliberately does not change on select: the fill and the
                             2px rule carry it, and recolouring as well made it shout. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource TabActiveFill}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SecondaryHover}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== SMALL PARTS ==================== -->

    <!-- Tag: accent tint 100 on tint 800. -->
    <!-- A stat value. Heavier than its label so the number reads first. -->
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!--
        A warning.

        A solid plate with a hatched edge bar — never text over stripes. The earlier draft set mono
        caps across a hazard hatch and it was illegible, which is why the hatch is now confined to a
        9px bar at the leading edge and the text sits on a flat fill.
    -->
    <!--
        A warning is a solid plate with a 9px edge bar, never text over a pattern. The edge bar is
        drawn by the call site; this carries the plate itself.
    -->
    <!--
        Label, implicitly.

        WPF's Label does not inherit Foreground — it defaults to SystemColors.ControlTextBrush, a
        near-black that vanishes on the dark ground. Every other control type here is templated; Label
        was the one omission, which cost 27 unreadable field captions across the editor, the
        passphrase prompt and the 2FA prompt.
    -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
        <Setter Property="Padding" Value="0,0,0,3" />
    </Style>

    <Style x:Key="WarningPlate" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WarnBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HazardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="WarningText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource WarnFg}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Small text on a filled accent uses the deeper step, roughly 7:1 rather than 3.7:1. -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="svc:Tracking.Em" Value="0.12" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentTint100}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="svc:Tracking.Em" Value="0.06" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTint800}" />
    </Style>

    <!-- The dashed "add" tile that ends the accounts and fleet grids. -->
    <Style x:Key="DashedTile" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource DashedBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Elevation. Used on exactly three things: the window shell, dialogs, and the tray toast. -->
    <DropShadowEffect x:Key="Elevation" BlurRadius="32" ShadowDepth="12" Direction="270"
                      Color="#2b2b2d" Opacity="0.22" />

    <Style x:Key="ContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Ground}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Ground}" BorderBrush="{DynamicResource Divider}"
                            BorderThickness="1">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu" BasedOn="{StaticResource ContextMenuStyle}" />

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RowHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource RuleLight}" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==================== ANIMATIONS ====================
         Three in the whole app, exactly as specified. -->

    <Storyboard x:Key="RamBlink" RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
            <LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:0" />
            <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1.2" />
            <LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:2.4" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="RamRise">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="8" To="0" Duration="0:0:0.18">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

</ResourceDictionary>
