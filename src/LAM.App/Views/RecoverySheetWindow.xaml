<Window x:Class="LAM.App.Views.RecoverySheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recovery sheet" Height="700" Width="720"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ShellWindow}">
    <DockPanel Margin="18">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
            <CheckBox x:Name="IncludeSecretsBox" Content="Include passwords and backup codes"
                      VerticalAlignment="Center" Click="OnToggleSecrets" />
            <TextBlock Text="  Riot Support will never ask for your password."
                       Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,0,0">
                <Button Content="Copy" Click="OnCopy" Margin="0,0,8,0" MinWidth="90" />
                <Button Content="Save as text…" Click="OnSave" Margin="0,0,8,0" MinWidth="120" />
                <Button Content="Close" Style="{StaticResource PrimaryButton}" Click="OnClose" MinWidth="90" />
            </StackPanel>
        </StackPanel>

        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <TextBox x:Name="SheetText" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12.5" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
