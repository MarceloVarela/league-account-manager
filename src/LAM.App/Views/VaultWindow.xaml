<Window x:Class="LAM.App.Views.VaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault" Height="680" Width="880" MinHeight="480" MinWidth="680"
        Background="{StaticResource Background}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="18,14">
            <StackPanel>
                <TextBlock Text="Vault" Style="{StaticResource Heading}" />
                <TextBlock x:Name="HeadlineText" Style="{StaticResource Muted}" Margin="0,3,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="18,7">
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
        </Border>

        <TabControl Margin="14" Background="Transparent" BorderBrush="{StaticResource BorderBrushSoft}">

            <!-- ============ HEALTH ============ -->
            <TabItem Header="Health">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               Text="Checked locally, in memory. Passwords are compared by fingerprint so no list of them is ever assembled, nothing is sent anywhere, and no finding below quotes a secret." />

                    <ItemsControl x:Name="FindingsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12" CornerRadius="6"
                                        Background="{StaticResource Surface}"
                                        BorderBrush="{Binding Accent}" BorderThickness="1,1,1,1">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding Accent}" Margin="0,2,8,0" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"
                                                   Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </TabItem>

            <!-- ============ TRASH ============ -->
            <TabItem Header="Trash">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               Text="Removed from the grid but still stored, passwords and recovery details intact. Purging is permanent — that part cannot be undone." />

                    <TextBlock x:Name="TrashEmptyText" DockPanel.Dock="Top" Style="{StaticResource Muted}"
                               Text="Nothing in the trash." Margin="0,6,0,0" />

                    <ItemsControl x:Name="TrashList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12" CornerRadius="6"
                                        Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"
                                                       FontSize="12" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Restore" Tag="{Binding Account}" Click="OnRestore"
                                                    MinWidth="82" Margin="0,0,8,0" />
                                            <Button Content="Purge" Tag="{Binding Account}" Click="OnPurge"
                                                    Style="{StaticResource DangerButton}" MinWidth="72" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </TabItem>

            <!-- ============ BACKUPS ============ -->
            <TabItem Header="Backups">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock x:Name="BackupText" FontFamily="Consolas" FontSize="12.5"
                                   LineHeight="20" TextWrapping="Wrap" />
                        <Button Content="Open backup folder" Click="OnOpenBackups" HorizontalAlignment="Left"
                                Margin="0,14,0,0" MinWidth="150" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
