<Window x:Class="LAM.App.Views.AccountEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account" Height="700" Width="620"
        Background="{StaticResource Background}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">

    <DockPanel Margin="18">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancel" Margin="0,0,8,0" MinWidth="90" />
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSave" MinWidth="110" />
        </StackPanel>

        <TextBlock x:Name="ValidationMessage" DockPanel.Dock="Bottom" Foreground="{StaticResource Danger}"
                   TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

        <TabControl Background="Transparent" BorderBrush="{StaticResource BorderBrushSoft}">

            <!-- ============ ACCOUNT ============ -->
            <TabItem Header="Account">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <Label Content="Name for this account" />
                        <TextBox x:Name="LabelBox" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Text="Just for you — &quot;main&quot;, &quot;smurf&quot;, &quot;the one I bought&quot;. The Riot ID fills itself in after the first sign-in." />

                        <Label Content="Riot login username" />
                        <TextBox x:Name="UsernameBox" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Text="What you type into the Riot Client. Often an email address, and not necessarily the same as the Riot ID." />

                        <Label Content="Password" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PasswordBox" Grid.Column="0" />
                            <TextBox x:Name="PasswordPlainBox" Grid.Column="0" Visibility="Collapsed" />
                            <Button Grid.Column="1" x:Name="RevealButton" Content="Show" Margin="8,0,0,0"
                                    Click="OnToggleReveal" MinWidth="70" />
                        </Grid>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Text="Typed into the client the first time you sign in. After that a saved session takes over and it is never typed again." />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Region" />
                                <ComboBox x:Name="RegionBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Client language" />
                                <ComboBox x:Name="LocaleBox" IsEditable="True" />
                            </StackPanel>
                        </Grid>

                        <Label Content="Tags" />
                        <TextBox x:Name="TagsBox" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14"
                                   Text="Comma separated. Used by the search box." />

                        <Label Content="Notes" />
                        <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ RECOVERY ============ -->
            <TabItem Header="Recovery">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <Border Background="#224C8DFF" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}"
                                       Text="Riot's API exposes no email and no creation date, so none of this can be filled in automatically — but it is exactly what Riot Support asks for when you are trying to prove an account is yours. Worth five minutes now." />
                        </Border>

                        <Label Content="Registered email" />
                        <TextBox x:Name="RecoveryEmailBox" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                                   Text="The single most important field here." />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Email provider" />
                                <TextBox x:Name="EmailProviderBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Phone on the account" />
                                <TextBox x:Name="PhoneBox" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="EmailControlledBox" Content="I still have access to that mailbox"
                                  Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14" TextWrapping="Wrap"
                                   Text="Untick this and the account is flagged on the grid — an account whose email you have lost needs a very different recovery route." />

                        <Label Content="Email password (optional)" />
                        <PasswordBox x:Name="EmailPasswordBox" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Text="Encrypted like everything else here. A dead Riot account is often gated behind a mailbox you can no longer open." />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Roughly when it was created" />
                                <!-- Month + year, not a calendar: Riot Support asks for an
                                     approximate date, and nobody remembers the day they made a
                                     smurf. Leave the month blank if you only know the year. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CreatedMonthBox" Grid.Column="0" />
                                    <ComboBox x:Name="CreatedYearBox" Grid.Column="2" MinWidth="86" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="How you got it" />
                                <TextBox x:Name="HowObtainedBox" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="First champion bought" />
                                <TextBox x:Name="FirstChampionBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Earliest purchase reference" />
                                <TextBox x:Name="PurchaseReferenceBox" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14" TextWrapping="Wrap"
                                   Text="Order number, store used, or the last four digits of the card. Classic Riot Support ownership questions." />

                        <CheckBox x:Name="MfaBox" Content="Two-factor authentication is enabled" Margin="0,0,0,8" />

                        <Label Content="Two-factor backup codes" />
                        <TextBox x:Name="BackupCodesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                                 VerticalScrollBarVisibility="Auto" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14"
                                   Text="One per line. Never written to a log or an error report." />

                        <Label Content="Security question answers" />
                        <TextBox x:Name="SecurityAnswersBox" AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                 VerticalScrollBarVisibility="Auto" />

                        <Label Content="Anything else worth remembering" Margin="0,12,0,0" />
                        <TextBox x:Name="RecoveryNotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ WHAT WE KNOW ============ -->
            <TabItem Header="Known">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                                   Text="Filled in automatically — by the League client after you sign in, and by the Riot API when you refresh. Nothing here is typed by you." />
                        <TextBlock x:Name="KnownText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                   LineHeight="19" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
