<Window x:Class="LAM.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LAM.App.ViewModels"
        Title="League Account Manager"
        Height="760" Width="1000" MinHeight="520" MinWidth="720"
        Background="{StaticResource Background}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:SignInModeBrushConverter x:Key="ModeBackground" Background="True" />
        <vm:SignInModeBrushConverter x:Key="ModeForeground" Background="False" />
    </Window.Resources>

    <Grid>

        <!-- ============ UNLOCKED: the account grid ============ -->
        <DockPanel Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">

            <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Accounts" Style="{StaticResource Heading}" />
                        <TextBlock Text="{Binding AccountCountText}" Style="{StaticResource Muted}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0"
                                VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBox x:Name="SearchBox" Width="240" VerticalAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                 ToolTip="Search by name, Riot ID, tag, note or recovery email.  Press / to focus." />

                        <TextBlock Text="Sort" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                   Margin="14,0,6,0" />
                        <ComboBox Width="112" VerticalAlignment="Center"
                                  ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" />

                        <TextBlock Text="Region" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                   Margin="14,0,6,0" />
                        <ComboBox Width="112" VerticalAlignment="Center"
                                  ItemsSource="{Binding RegionOptions}" SelectedItem="{Binding RegionFilter}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Add account" Style="{StaticResource PrimaryButton}"
                                Click="OnAddAccount" Margin="0,0,8,0" />
                        <Button Content="Refresh ranks" Click="OnRefreshAll" Margin="0,0,8,0"
                                ToolTip="Look up rank and level for every account (needs a Riot API key)" />
                        <Button Content="Vault" Click="OnOpenVault" Margin="0,0,8,0"
                                ToolTip="Vault health, password reuse, backups and the trash" />
                        <Button Content="Fleet" Click="OnOpenFleet" Margin="0,0,8,0"
                                ToolTip="Search every account's collection at once, and see what is idle or expiring" />
                        <Button Content="Settings" Click="OnOpenSettings" Margin="0,0,8,0" />
                        <Button Content="Lock" Click="OnLock" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="16,7">
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
            </Border>

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,16,4,16">
                    <ItemsControl ItemsSource="{Binding VisibleAccounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AccountTile}">
                                <Border Style="{StaticResource AccountCard}"
                                        MouseLeftButtonUp="OnCardClicked" Cursor="Hand"
                                        ToolTip="Click to open this account">
                                    <StackPanel>

                                        <!-- Icon, name, rank, overflow menu -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Ringed in the rank's colour; falls back to initials
                                                 until an icon has been cached. -->
                                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26"
                                                    Background="{StaticResource SurfaceRaised}"
                                                    BorderBrush="{Binding RankBrush}" BorderThickness="2"
                                                    Margin="0,0,12,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initials}" FontSize="17"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource MutedText}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding ShowInitials, Converter={StaticResource BoolToVis}}" />
                                                    <!-- An Ellipse filled with the image, not a clipped Border:
                                                         ClipToBounds does not respect CornerRadius in WPF, so the
                                                         square corners of the icon printed behind the ring. -->
                                                    <Ellipse Fill="{Binding IconBrush}"
                                                             Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                <TextBlock Text="{Binding RankText}" FontWeight="SemiBold"
                                                           FontSize="12.5" Margin="0,5,0,0"
                                                           Foreground="{Binding RankBrush}" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="⋯" Padding="8,0" FontSize="15"
                                                    VerticalAlignment="Top" Click="OnCardMenu" Tag="{Binding}"
                                                    ToolTip="Edit, recovery sheet, remove" />
                                        </Grid>

                                        <TextBlock Text="{Binding FlexRankText}" Style="{StaticResource Muted}"
                                                   FontSize="11" Margin="64,3,0,0"
                                                   Visibility="{Binding HasFlexRank, Converter={StaticResource BoolToVis}}" />

                                        <Separator Margin="0,12,0,10" Background="{StaticResource BorderBrushSoft}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding LevelText}" Style="{StaticResource Muted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding RegionText}" Style="{StaticResource Muted}"
                                                       Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding LastUsedText}" Style="{StaticResource Muted}" />
                                        </Grid>

                                        <!-- Wallet and collection, read from the client. Dated on the
                                             next line because it is a snapshot from the last sign-in
                                             rather than a live reading. -->
                                        <StackPanel Margin="0,8,0,0"
                                                    Visibility="{Binding HasStats, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding StatsLine}" Style="{StaticResource Muted}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatsAsOfText}" Foreground="#FF6B7280"
                                                       FontSize="10" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,9,0,0"
                                                      Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Chip}">
                                                        <TextBlock Text="{Binding}" FontSize="11" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Sign-in is a deliberate press, not a side effect of
                                             clicking the card: it closes the Riot Client and League,
                                             so a stray click on the wrong card kills a running one. -->
                                        <Button Content="Sign in" Style="{StaticResource PrimaryButton}"
                                                Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                                Click="OnSignInClicked" Tag="{Binding}"
                                                IsEnabled="{Binding CanSignIn}"
                                                ToolTip="{Binding SignInTooltip}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Border CornerRadius="4" Padding="7,3"
                                                    Background="{Binding IsInstant, Converter={StaticResource ModeBackground}}">
                                                <TextBlock Text="{Binding SignInModeText}" FontSize="11"
                                                           Foreground="{Binding IsInstant, Converter={StaticResource ModeForeground}}" />
                                            </Border>

                                            <!-- With a dozen smurfs, "which one am I on?" is the first
                                                 question every time, and only the client knows. -->
                                            <Border CornerRadius="4" Padding="7,3" Margin="6,0,0,0"
                                                    Background="#334C8DFF"
                                                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Signed in now" FontSize="11"
                                                           Foreground="{StaticResource Accent}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding RecoveryWarning}" Foreground="{StaticResource Warning}"
                                                   FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasRecoveryWarning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Shown when the vault is empty or the search matched nothing -->
                <TextBlock x:Name="EmptyHint" Style="{StaticResource Muted}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                           Visibility="Collapsed" />
            </Grid>
        </DockPanel>

        <!-- ============ LOCKED ============ -->
        <Grid Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"
              Background="{StaticResource Background}">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1" CornerRadius="10" Padding="34"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <StackPanel>
                    <TextBlock x:Name="LockTitle" Text="Unlock your accounts" Style="{StaticResource Heading}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="LockSubtitle" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,20" />

                    <Label Content="Master password" />
                    <PasswordBox x:Name="MasterPasswordBox" KeyDown="OnMasterPasswordKeyDown" />

                    <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <Label Content="Confirm master password" />
                        <PasswordBox x:Name="ConfirmPasswordBox" KeyDown="OnMasterPasswordKeyDown" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="There is no way to reset this. If you forget it, the accounts inside are gone — so pick something you will still know in a year, and consider writing it down somewhere physical." />
                    </StackPanel>

                    <TextBlock x:Name="LockError" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="Collapsed" />

                    <Button x:Name="UnlockButton" Content="Unlock" Style="{StaticResource PrimaryButton}"
                            Margin="0,18,0,0" Click="OnUnlock" />

                    <Button x:Name="HelloButton" Content="Use Windows Hello" Margin="0,8,0,0"
                            Click="OnUnlockWithHello" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ BUSY OVERLAY ============ -->
        <Grid Background="#DD0D0F13" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1" CornerRadius="10" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                <StackPanel>
                    <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource Heading}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,18"
                                 Background="{StaticResource Background}" Foreground="{StaticResource Accent}"
                                 BorderThickness="0" />

                    <TextBlock Text="{Binding BusyDetail}" Style="{StaticResource Muted}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding HasBusyDetail, Converter={StaticResource BoolToVis}}" />

                    <!-- Only while keystrokes are actually being sent. During an instant sign-in
                         there is nothing to interfere with, and a warning shown every time is a
                         warning you stop reading. -->
                    <Border Background="#33E0A73C" CornerRadius="6" Padding="12" Margin="0,16,0,0"
                            Visibility="{Binding BusyIsTyping, Converter={StaticResource BoolToVis}}">
                        <TextBlock Foreground="{StaticResource Warning}" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="Typing your password — please don't touch the mouse or keyboard. If focus moves, typing stops automatically and nothing more is sent." />
                    </Border>

                    <Button Content="Cancel" Margin="0,18,0,0" Click="OnCancelLogin"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
