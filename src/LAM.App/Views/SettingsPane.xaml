<UserControl x:Class="LAM.App.Views.SettingsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- One settings row: label and note on the left, a control on the right. -->
        <DataTemplate x:Key="SettingRow">
            <Border BorderBrush="{DynamicResource RuleLight}" BorderThickness="0,0,0,1" Padding="14,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <!--
                            The dim-when-disabled step is a trigger over DynamicResource, not a brush
                            resolved in C#. A one-shot Resources[...] lookup is a StaticResource in
                            disguise: it captures the palette that was live when the row was built and
                            never updates, so toggling the theme from this very pane left every label
                            painted in the outgoing palette's ink.
                        -->
                        <TextBlock Text="{Binding Label}" FontSize="13.5" FontWeight="Medium"
                                   FontFamily="{StaticResource BodyFont}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- In the Style, NOT on the element: an attribute is a local
                                         value and outranks the trigger below, so writing
                                         Foreground="..." up there silently disabled the dim. -->
                                    <Setter Property="Foreground" Value="{DynamicResource Ink}" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource Mono}" Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <CheckBox Grid.Column="1" Style="{StaticResource SettingToggle}"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsOn, Mode=TwoWay}"
                              IsEnabled="{Binding IsEnabled}"
                              ToolTip="{Binding Tip}"
                              Visibility="{Binding IsToggle, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Mono}"
                               FontSize="11" VerticalAlignment="Center"
                               Visibility="{Binding IsValue, Converter={StaticResource BoolToVis}}" />

                    <Button Grid.Column="1" Content="{Binding ActionLabel}" MinHeight="26"
                            Padding="12,0" FontSize="12" VerticalAlignment="Center"
                            Command="{Binding Action}"
                            Visibility="{Binding IsAction, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One framed group panel with a hatched header band. -->
        <DataTemplate x:Key="SettingGroup">
            <Grid Margin="6,6,26,26">
                <Border Background="{DynamicResource Ground}" BorderBrush="{DynamicResource Divider}"
                        BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource RaisedSurface}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                                Padding="14,10">
                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource HeadingFont}"
                                       FontWeight="SemiBold" FontSize="17" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SettingRow}" />
                    </DockPanel>
                </Border>

                <Path Style="{StaticResource RegistrationMark}" HorizontalAlignment="Left"
                      VerticalAlignment="Top" Margin="-6,-6,0,0" />
                <Path Style="{StaticResource RegistrationMark}" HorizontalAlignment="Right"
                      VerticalAlignment="Top" Margin="0,-6,-6,0" />
                <Path Style="{StaticResource RegistrationMark}" HorizontalAlignment="Left"
                      VerticalAlignment="Bottom" Margin="-6,0,0,-6" />
                <Path Style="{StaticResource RegistrationMark}" HorizontalAlignment="Right"
                      VerticalAlignment="Bottom" Margin="0,0,-6,-6" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <ItemsControl x:Name="Groups" ItemTemplate="{StaticResource SettingGroup}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock x:Name="StatusText" Style="{StaticResource Mono}" Margin="6,4,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
