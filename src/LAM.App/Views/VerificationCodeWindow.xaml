<Window x:Class="LAM.App.Views.VerificationCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="Auto" Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True"
        Style="{StaticResource ShellWindow}"
        Title="Verification Code">
    <StackPanel Margin="22">
        <TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,0,0,16" />

        <Label Content="Code" />
        <TextBox x:Name="CodeBox" FontSize="19" FontFamily="Consolas" Padding="10,8" KeyDown="OnKeyDown" />

        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="An account with two-factor turned on can never be completely hands-free — this is the one moment it needs you." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel sign-in" Click="OnCancel" Margin="0,0,8,0" />
            <Button Content="Continue" Style="{StaticResource PrimaryButton}" Click="OnOk" MinWidth="100" />
        </StackPanel>
    </StackPanel>
</Window>
