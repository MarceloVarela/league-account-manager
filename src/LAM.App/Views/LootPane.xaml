<UserControl x:Class="LAM.App.Views.LootPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Margin="22">

        <!-- Four stat plates. Framed, with their registration marks. -->
        <ItemsControl x:Name="Plates" DockPanel.Dock="Top" Margin="0,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="6,6,26,6">
                        <Border Background="{DynamicResource Ground}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" Padding="14,13">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Mono}" />
                                <TextBlock Text="{Binding Figure}" FontFamily="{StaticResource HeadingFont}"
                                           FontWeight="SemiBold" FontSize="30" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Note}" FontSize="11.5"
                                           Foreground="{DynamicResource MutedText}" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Path Style="{StaticResource RegistrationMark}" HorizontalAlignment="Left"
                              VerticalAlignment="Top" Margin="-6,-6,0,0" />
                        <Path Style="{StaticResource RegistrationMark}" HorizontalAlignment="Right"
                              VerticalAlignment="Top" Margin="0,-6,-6,0" />
                        <Path Style="{StaticResource RegistrationMark}" HorizontalAlignment="Left"
                              VerticalAlignment="Bottom" Margin="-6,0,0,-6" />
                        <Path Style="{StaticResource RegistrationMark}" HorizontalAlignment="Right"
                              VerticalAlignment="Bottom" Margin="0,0,-6,-6" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Style="{StaticResource Muted}"
                   Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed" />

        <!-- One framed table. Columns are fixed so a long value cannot force horizontal overflow. -->
        <Grid Margin="6,0,26,6">
            <Border Background="{DynamicResource Ground}" BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Divider}"
                            BorderThickness="0,0,0,1" Padding="14,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ITEM" Style="{StaticResource Mono}" />
                            <TextBlock Grid.Column="1" Text="TYPE" Style="{StaticResource Mono}" />
                            <TextBlock Grid.Column="2" Text="ACCOUNT" Style="{StaticResource Mono}" />
                            <TextBlock Grid.Column="3" Text="QTY" Style="{StaticResource Mono}" />
                            <TextBlock Grid.Column="4" Text="DISENCHANTS" Style="{StaticResource Mono}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="Rows" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource RuleFaint}" BorderThickness="0,0,0,1"
                                        Padding="14,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Rarity}" Style="{StaticResource Mono}"
                                                       Foreground="{DynamicResource AccentPressed}"
                                                       Margin="8,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Category}"
                                                   Style="{StaticResource Mono}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Account}"
                                                   Style="{StaticResource Mono}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Quantity}"
                                                   Style="{StaticResource Mono}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Essence}"
                                                   Style="{StaticResource Mono}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Path Style="{StaticResource RegistrationMark}" HorizontalAlignment="Left"
                  VerticalAlignment="Top" Margin="-6,-6,0,0" />
            <Path Style="{StaticResource RegistrationMark}" HorizontalAlignment="Right"
                  VerticalAlignment="Top" Margin="0,-6,-6,0" />
            <Path Style="{StaticResource RegistrationMark}" HorizontalAlignment="Left"
                  VerticalAlignment="Bottom" Margin="-6,0,0,-6" />
            <Path Style="{StaticResource RegistrationMark}" HorizontalAlignment="Right"
                  VerticalAlignment="Bottom" Margin="0,0,-6,-6" />
        </Grid>
    </DockPanel>
</UserControl>
