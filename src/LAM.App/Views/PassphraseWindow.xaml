<Window x:Class="LAM.App.Views.PassphraseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="Auto" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource ShellWindow}"
        Title="Passphrase">
    <StackPanel Margin="22">
        <TextBlock x:Name="Explanation" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <Label Content="Passphrase" />
        <PasswordBox x:Name="FirstBox" KeyDown="OnKeyDown" />

        <StackPanel x:Name="ConfirmPanel" Margin="0,12,0,0">
            <Label Content="Confirm passphrase" />
            <PasswordBox x:Name="SecondBox" KeyDown="OnKeyDown" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource WarnFg}" TextWrapping="Wrap"
                   Margin="0,12,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="OnCancel" Margin="0,0,8,0" MinWidth="90" />
            <Button Content="OK" Style="{StaticResource PrimaryButton}" Click="OnOk" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
