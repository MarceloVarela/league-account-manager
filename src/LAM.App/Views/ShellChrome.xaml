<!--
    The window shell: title bar, nav tabs and status bar.

    Kept in its own dictionary because it is chrome rather than theme — these are the pieces that
    make the window frameless, and they are referenced by MainWindow alone.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:svc="clr-namespace:LAM.App.Services"
                    xmlns:vm="clr-namespace:LAM.App.ViewModels">

    <vm:TierBrushConverter x:Key="TierBrush" />

    <!-- Mono metadata that sits in chrome bands: slightly stronger than body mono so it survives
         on the surface fill. -->
    <Style x:Key="ChromeMono" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Condensed label used across the title bar and status bar. -->
    <Style x:Key="ChromeLabel" TargetType="TextBlock">
        <Setter Property="svc:Tracking.Em" Value="0.16" />
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The app mark: three stacked cards, the front one solid. Same construction as the icon. -->
    <ControlTemplate x:Key="AppMark" TargetType="ContentControl">
        <Grid Width="16" Height="16" SnapsToDevicePixels="True">
            <Border Width="11" Height="8" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0" />
            <Border Width="11" Height="8" Background="{DynamicResource Accent}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,1" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="AppMarkStyle" TargetType="ContentControl">
        <Setter Property="Template" Value="{StaticResource AppMark}" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- A nav tab: label plus its count in mono. Selected gets the tinted fill and the 2px rule;
         the text colour deliberately stays put. -->
    <Style x:Key="NavTab" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Height="46" Padding="16,0" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="{StaticResource HeadingFont}" FontWeight="SemiBold"
                                       FontSize="15" Foreground="{DynamicResource Ink}" />
                            <!-- NOT a TemplateBinding: that is a lightweight binding with no value
                                 conversion, so binding string Text to an int Tag produced nothing at
                                 all and every tab count silently rendered blank. -->
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Style="{StaticResource Mono}" Margin="7,3,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource TabActiveFill}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SecondaryHover}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented control used by the accounts toolbar. -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Padding="12,0" Height="30" Background="Transparent"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                        <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                   FontFamily="{StaticResource HeadingFont}" FontWeight="SemiBold"
                                   FontSize="12.5" Foreground="{DynamicResource Ink}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SegmentSelected}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SecondaryHover}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One cell of the ten-cell LP rule. -->
    <!--
        One cell of the ten-cell LP rule.

        A filled cell takes the account's TIER colour, not the accent — with the rank text and the
        card's top band, this is the third and widest of the three places tier colour lands. The
        binding walks up to the card's own DataContext because the cell's DataContext is the bare
        bool the collection yields.
    -->
<!--
        One bar of the last-ten form chart.

        Two axes separate this from the LP rule directly above it: HEIGHT (a win is 15px against the
        rule's flat 6px) and HUE (win/loss, not tier). The design differentiates by height alone and
        it did not read - stacked 9px apart in one colour, the two bars scanned as a single confusing
        double-rule. Green/loss-red is also what every tracker has trained players on.
    -->
    <DataTemplate x:Key="FormBar">
        <!--
            NOTHING that a trigger below sets may also be set as an attribute on this Border.

            A value written directly on an element is a LOCAL value, and local values outrank style
            triggers in WPF's precedence chain. Height and Background therefore start life in the
            Style as ordinary setters, so the triggers can actually win. Writing Height="15" and
            Background="..." on the element instead — which is how this was first built — left every
            bar an identical muted stub: the triggers fired, the brushes resolved, and the results
            were discarded.
        -->
        <Border Width="5" Margin="0,0,2,0" VerticalAlignment="Bottom">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Height" Value="15" />
                    <Setter Property="Background" Value="{DynamicResource LossBar}" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Ok}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}" Value="False">
                            <!-- A loss is a short stub, so the row's silhouette alone reads as form. -->
                            <Setter Property="Height" Value="6" />
                            <Setter Property="Background" Value="{DynamicResource WarnFg}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </DataTemplate>

    <!--
        One cell of the ten-cell LP rule. Same precedence rule as the form bar above: the unfilled
        colour is a Style setter, never an attribute, or the tier fill can never take effect.
    -->
    <DataTemplate x:Key="LpCell">
        <Border Height="6" Margin="0,0,2,0" MinWidth="9" HorizontalAlignment="Stretch">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource InactiveFill}" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="True">
                            <Setter Property="Background"
                                    Value="{Binding DataContext.TierKey,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl},
                                            Converter={StaticResource TierBrush}}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </DataTemplate>

</ResourceDictionary>
